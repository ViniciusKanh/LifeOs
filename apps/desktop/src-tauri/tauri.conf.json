{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeOS",
  "version": "0.4.0",
  "identifier": "br.com.lifeos.desktop",
  "build": {
    "frontendDist": "../boot"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https:",
        "object-src": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Vinicius Santos",
    "category": "Productivity",
    "shortDescription": "LifeOS — Transforme sua rotina em progresso.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "createUpdaterArtifacts": true,
    "copyright": "© 2026 Vinicius Santos. Todos os direitos reservados.",
    "homepage": "https://lifeos-sigma-five.vercel.app",
    "longDescription": "LifeOS é o seu sistema operacional pessoal: tarefas, projetos, estudos, saúde, hábitos, diário e analytics em um só lugar — Planejar, Executar, Registrar, Medir, Melhorar.",
    "licenseFile": "installer/license.rtf"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzRDE0MTBFODhGRDkyOTgKUldTWWt2MklEa0hSTTZiL1dqVkordlVSUWNVYTVlZ3Qvd2JjWWpVaVI5N1RPeCt1YmJuaklCSkwK",
      "endpoints": [
        "https://github.com/ViniciusKanh/LifeOs/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "lifeos"
        ]
      }
    }
  }
}
