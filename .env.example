# ============================================================
# LifeOS — variáveis de ambiente (exemplo)
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA cometer o .env real no repositório.
# ============================================================

# ---------- API (apps/api) ----------

# Porta do servidor da API
PORT=3333

# URL pública permitida a consumir a API (CORS)
WEB_ORIGIN=http://localhost:5173

# --- Banco de dados (Turso / libSQL) ---
# Em desenvolvimento local, pode apontar para um arquivo local:
#   DATABASE_URL=file:./data/lifeos.db
# Em produção, aponte para o banco Turso:
#   DATABASE_URL=libsql://seu-banco.turso.io
DATABASE_URL=libsql://lifeos-viniciuskanh.aws-us-east-1.turso.io
DATABASE_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3ODkyMzc5NjgsImlkIjoiMDFhMDk2ZTQtYWIwMS03ZjhjLTk5ODUtN2MyYzk4YTVmZTFjIiwia2lkIjoia25aS0ZhRTdKVXNVRnVEb01LaGpBTDZVOVkwQ3NJaHItWFpKSWNXMmxXVSIsInJpZCI6IjBlZDMyYzI5LTA0NzAtNDhiOC04MGU5LWNmMDU1ZGMxZTJjNSJ9.QEQOFPNqJk7966nX555QXSdx5Qldifl1ooCmLn92JnqPhWlwdyvSpn2FdOfHZVJ4eEUvlRFpgZnWBGqZ885NDQ

# --- Autenticação ---
# Segredo usado para assinar tokens JWT de sessão. Gere um valor
# aleatório forte (ex: openssl rand -hex 32) e nunca reutilize
# entre ambientes.
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=7d

# Chave usada para criptografar credenciais sensíveis salvas no
# banco (Gemini API Key, Turso Token, senha SMTP). 32 bytes em hex.
CREDENTIALS_ENCRYPTION_KEY=troque-este-valor-por-32-bytes-em-hex

# E-mail do administrador principal do LifeOS. Esse usuário é
# promovido automaticamente a role='admin' na inicialização.
ADMIN_EMAIL=viniciussouza742@gmail.com

# --- Rate limiting ---
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ---------- Web (apps/web) ----------

# URL base da API consumida pelo frontend
VITE_API_URL=http://localhost:3333/api
