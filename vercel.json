{
  "version": 2,
  "buildCommand": "npm run build --workspace apps/web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "functions": {
    "apps/api/api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/apps/api/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
